# ClipRush laptop settings. Keep this file private (it never leaves your laptop).

# Your GitHub repository, e.g.  yourname/cliprush
CLIPRUSH_REPO=yourname/cliprush

# GitHub fine-grained token: Settings > Developer settings > Fine-grained tokens >
# only this repository > Permissions: Contents = Read and write.
CLIPRUSH_GITHUB_TOKEN=

# The same password you saved as the CLIPRUSH_PASSWORD secret on GitHub.
CLIPRUSH_PASSWORD=

# Optional free AI keys (same as on GitHub). Leave empty to use rules only.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: Apify free plan token (backup X study).
APIFY_TOKEN=

# Optional: send APPROVED clips to your phone through your own free Telegram bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
